<!DOCTYPE html>
<html>

<head>

  <title>MCQ Practice</title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #121212;
      color: white;
      padding: 20px;
    }

    .container {
      max-width: 1000px;
      margin: auto;
    }

    h1 {
      margin-bottom: 10px;
    }

    .subtitle {
      color: #aaa;
      margin-bottom: 25px;
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .back {
      color: #00d9ff;
      text-decoration: none;
    }

    .add-btn {
      background: #2962ff;
      color: white;
      padding: 10px 16px;
      border-radius: 8px;
      text-decoration: none;
    }

    .cards {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(250px, 1fr));

      gap: 20px;
    }

    .card {
      background: #1e1e1e;
      padding: 25px;
      border-radius: 15px;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .icon {
      font-size: 35px;
      margin-bottom: 15px;
    }

    .card h2 {
      margin-bottom: 10px;
    }

    .count {
      font-size: 30px;
      font-weight: bold;
      margin: 15px 0;
    }

    .practice {
      display: inline-block;
      background: #00c853;
      color: white;
      text-decoration: none;
      padding: 10px 18px;
      border-radius: 8px;
    }

    @media(max-width:600px) {

      body {
        padding: 12px;
      }

      .card {
        padding: 20px;
      }

    }

  </style>

</head>

<body>

<div class="container">

  <div class="top-bar">

    <a href="/" class="back">
      ← Back to Study Tracker
    </a>

    <a href="/mcq/add" class="add-btn">
      + Add Question
    </a>

  </div>


  <h1>📝 MCQ Practice</h1>

  <p class="subtitle">
    Current Affairs • Banking Awareness • Static GK
  </p>


  <div class="cards">


    <!-- CURRENT AFFAIRS -->

    <div class="card">

      <div class="icon">📰</div>

      <h2>Current Affairs</h2>

      <p>
        Practice your current affairs questions.
      </p>

      <div class="count">
        <%= currentAffairs %>
      </div>

      <p>Questions</p>

      <br>

      <a
        href="/mcq/practice?category=Current%20Affairs"
        class="practice"
      >
        Practice
      </a>

    </div>


    <!-- BANKING -->

    <div class="card">

      <div class="icon">🏦</div>

      <h2>Banking Awareness</h2>

      <p>
        Practice banking awareness questions.
      </p>

      <div class="count">
        <%= bankingAwareness %>
      </div>

      <p>Questions</p>

      <br>

      <a
        href="/mcq/practice?category=Banking%20Awareness"
        class="practice"
      >
        Practice
      </a>

    </div>


    <!-- STATIC GK -->

    <div class="card">

      <div class="icon">🌎</div>

      <h2>Static GK</h2>

      <p>
        Practice static general knowledge.
      </p>

      <div class="count">
        <%= staticGK %>
      </div>

      <p>Questions</p>

      <br>

      <a
        href="/mcq/practice?category=Static%20GK"
        class="practice"
      >
        Practice
      </a>

    </div>


  </div>

</div>

</body>

</html>