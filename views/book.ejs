<!DOCTYPE html>
<html>
<head>
<title><%= book.name %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{
  font-family:Arial;
  background:#121212;
  color:white;
  padding:20px;
}
.container{max-width:1100px;margin:auto;}
h1,h2{margin-bottom:15px;}
a{color:#00d9ff;text-decoration:none;}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}

.card,.topic,.box{
  background:#1e1e1e;
  padding:18px;
  border-radius:14px;
}

.progress{
  width:100%;
  height:18px;
  background:#333;
  border-radius:10px;
  overflow:hidden;
  margin-top:10px;
}
.fill{
  height:100%;
  background:#00c853;
}

form{margin:15px 0;}
input{
  width:100%;
  padding:10px;
  margin-bottom:10px;
  border:none;
  border-radius:10px;
}

button{
  padding:10px 14px;
  border:none;
  border-radius:10px;
  color:white;
  cursor:pointer;
}

.blue{background:#2962ff;}
.green{background:#00c853;}
.red{background:#d50000;}
.gray{background:#444;}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:10px;
}

canvas{
  background:#1e1e1e;
  padding:15px;
  border-radius:14px;
}

.section{margin-top:25px;}

@media(max-width:600px){
  body{padding:12px;}
}
</style>
</head>
<body>

  <div class="section">
    <h2>📝 Notes</h2>
    
    <form action="/book/<%= book._id %>/add-note" method="POST">
      <input type="text" name="title" placeholder="Note Title" required>
      <input type="text" name="content" placeholder="Write Note..." required>
      <button class="blue">Add Note</button>
    </form>
    </div>
    
    <div class="section">
    
    <% if(notes.length === 0){ %>
    
    <div class="box">
    <p>No notes yet.</p>
    </div>
    
    <% } %>
    
    <% notes.forEach(note => { %>
    
    <div class="box">
    <h3><%= note.title %></h3>
    <p style="margin-top:10px;"><%= note.content %></p>
    
    <div class="actions" style="margin-top:15px;">
    <a href="/note/<%= note._id %>/delete">
    <button class="red">Delete</button>
    </a>
    </div>
    </div>
    
    <% }) %>
    
    </div>

<div class="container">

<h1><%= book.name %></h1>
<a href="/">← Back</a>

<div class="section grid">

<div class="card">
<h3>Total Questions</h3>
<p><%= totalQ %></p>
</div>

<div class="card">
<h3>Solved</h3>
<p><%= solvedQ %></p>
</div>

<div class="card">
<h3>Remaining</h3>
<p><%= totalQ - solvedQ %></p>
</div>

<div class="card">
<h3>Completion</h3>
<p><%= progress %>%</p>
</div>

</div>

<div class="section">
<div class="progress">
<div class="fill" style="width:<%= progress %>%"></div>
</div>
</div>

<div class="section grid">

<div class="box">
<h3>🏆 Best Topic</h3>
<p>
<%= bestTopic ? bestTopic.name : "No Topics Yet" %>
</p>
</div>

<div class="box">
<h3>⚠ Weak Topic</h3>
<p>
<%= weakTopic ? weakTopic.name : "No Topics Yet" %>
</p>
</div>

</div>

<div class="section grid">

<div>
<canvas id="pieChart"></canvas>
</div>

<div>
<canvas id="barChart"></canvas>
</div>

</div>

<div class="section">
<h2>Add Topic</h2>

<form action="/book/<%= book._id %>/add-topic" method="POST">
<input type="text" name="name" placeholder="Topic Name" required>
<input type="number" name="totalQuestions" placeholder="Total Questions" required>
<button class="blue">Add Topic</button>
</form>
</div>

<div class="section">
<h2>Topics</h2>

<% topics.forEach(topic => {
let remaining = topic.totalQuestions - topic.solvedQuestions;
let percent = ((topic.solvedQuestions / topic.totalQuestions) * 100).toFixed(1);
%>

<div class="topic">

<h3><%= topic.name %></h3>
<p>Total: <%= topic.totalQuestions %></p>
<p>Solved: <%= topic.solvedQuestions %></p>
<p>Remaining: <%= remaining %></p>
<p>Completion: <%= percent %>%</p>

<div class="progress">
<div class="fill" style="width:<%= percent %>%"></div>
</div>

<form action="/topic/<%= topic._id %>/update" method="POST">
<input type="number" name="solvedQuestions" placeholder="Enter Solved Count" required>
<button class="gray">Update</button>
</form>

<div class="actions">
  
<a href="/topic/<%= topic._id %>/add/50"><button class="green">+50</button></a>
<a href="/topic/<%= topic._id %>/add/25"><button class="blue">+25</button></a>
<a href="/topic/<%= topic._id %>/delete"><button class="red">Delete</button></a>
</div>

</div>

<% }) %>

</div>

</div>

<script>
const solved = <%= solvedQ %>;
const remain = <%= totalQ - solvedQ %>;

new Chart(document.getElementById("pieChart"), {
  type: "pie",
  data: {
    labels: ["Solved", "Remaining"],
    datasets: [{
      data: [solved, remain]
    }]
  }
});

new Chart(document.getElementById("barChart"), {
  type: "bar",
  data: {
    labels: [<% topics.forEach((t,i)=>{ %>"<%= t.name %>"<%= i < topics.length-1 ? "," : "" %><% }) %>],
    datasets: [{
      label: "Solved Questions",
      data: [<% topics.forEach((t,i)=>{ %><%= t.solvedQuestions %><%= i < topics.length-1 ? "," : "" %><% }) %>]
    }]
  }
});
</script>

</body>
</html>